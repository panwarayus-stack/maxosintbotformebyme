{
"version": 2,
"functions": {
"api/*.js": {
"runtime": "nodejs24.x"
}
},
"env": {
"NODE_NO_WARNINGS": "1",
"NODE_OPTIONS": "--no-warnings"
},
"rewrites": [
{
"source": "/num",
"destination": "/num.html"
},
{
"source": "/adhar",
"destination": "/adhar.html"
},
{
"source": "/upi",
"destination": "/upi.html"
},
{
"source": "/vehicle",
"destination": "/vehicle.html"
},
{
"source": "/imei",
"destination": "/imei.html"
},
{
"source": "/pincode",
"destination": "/pincode.html"
},
{
"source": "/ip",
"destination": "/ip.html"
},
{
"source": "/ifsc",
"destination": "/ifsc.html"
},
{
"source": "/osint",
"destination": "/osint.html"
},
{
"source": "/gst",
"destination": "/gst.html"
},
{
"source": "/tools",
"destination": "/tools.html"
},
{
"source": "/session",
"destination": "/session.html"
},
{
"source": "/bomber",
"destination": "/bomber.html"
},
{
"source": "/freeapi",
"destination": "/freeapi.html"
},
{
"source": "/api",
"destination": "/api.html"
},
{
"source": "/apifree",
"destination": "/apifree.html"
},
{
"source": "/emailspoof",
"destination": "/emailspoof.html"
}
]
}
